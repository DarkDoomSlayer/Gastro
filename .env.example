# ==============================================================================
# GastroProyect — Configuración de Entorno (Environment Variables)
# ==============================================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=gastro_user
POSTGRES_PASSWORD=gastro_password
POSTGRES_DB=gastro_db
POSTGRES_PORT=5432

# URL de conexión interna para el Backend (Docker network)
DATABASE_URL=postgresql://gastro_user:gastro_password@db:5432/gastro_db

# Configuración del Backend (API)
BACKEND_PORT=4000
NODE_ENV=development

# Configuración del Frontend (SPA)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
