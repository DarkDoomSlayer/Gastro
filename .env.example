# Configuración del Backend (Django REST Framework)
DEBUG=0
SECRET_KEY=django-insecure-gastro-costeo-dev-key-2026
DJANGO_ALLOWED_HOSTS=*

# Base de Datos Relacional (PostgreSQL)
POSTGRES_DB=gastro_db
POSTGRES_USER=gastro_user
POSTGRES_PASSWORD=gastro_password123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Configuración del Frontend (React + Vite)
VITE_BACKEND_INTERNAL_URL=http://backend:8000
